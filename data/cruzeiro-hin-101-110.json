      "title": "Sou Filho Deste Poder",
      "rhythm": "MARCHA",
      "offeredTo": null,
      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "Sou filho deste poder",
            "Vivo na terra e no mar",
            "Implorando ao meu Pai Eterno",
            "Nas alturas onde Ele está"
          ],
          "bars": [
            [
              0,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "Eu vivo aqui cantando",
            "Para quem tiver amor",
            "Consagrando a minha Rainha",
            "Foi Ela que me ensinou"
          ],
          "bars": []
        },
        {
          "verses": [
            "Todos santos e todas santas",
            "Roguem a Deus no coração",
            "Para os filhos da terra",
            "Se esquecer da ilusão"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "lyricsStatus": "transcribed_from_UNAQUI",
      "barsStatus": "double_checked_pdf_pending_author_visual_homologation",
      "sourceUrl": "https://unaqui.wordpress.com/"
    },
    {
