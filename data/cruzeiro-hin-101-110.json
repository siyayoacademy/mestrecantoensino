    {
      "number": 101,
      "title": "No brilho da Lua Branca",
      "rhythm": "MARCHA",
      "offeredTo": null,
      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "No brilho da Lua Branca",
            "Foi quem me trouxe aqui",
            "Doutrinar a quem quiser",
            "Neste caminho a seguir"
          ],
          "bars": [
            [
              0,
              2,
              9
            ],
            [
              2,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "Sou filho desta verdade",
            "Eu devo caprichar assim",
            "Caprichar eternamente",
            "Para nunca ser ruim"
          ],
          "bars": []
        },
        {
          "verses": [
            "Lua Branca quem me trouxe",
            "Confiou-me este lugar",
            "Para ser filho legítimo",
            "É preciso doutrinar"
          ],
          "bars": []
        },
        {
          "verses": [
            "A minha Mãe que me ensina",
            "Tudo quanto eu quiser",
            "Peço força, peço força",
            "A meu Pai que tem poder"
          ],
          "bars": []
        },
        {
          "verses": [
            "A minha Mãe foi quem me deu",
            "Neste mundo este lugar",
            "Peço força e dou força",
            "E não saio do meu lugar"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "lyricsStatus": "transcribed_from_UNAQUI",
      "barsStatus": "double_checked_pdf_pending_author_visual_homologation",
      "sourceUrl": "https://unaqui.wordpress.com/"
    },
    {
