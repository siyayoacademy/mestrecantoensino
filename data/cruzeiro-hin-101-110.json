      "rhythm": "MARCHA",
      "offeredTo": null,
      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "Chamei lá nas alturas",
            "Para o Divino me ouvir",
            "A minha Mãe me respondeu",
            "Ôh filho meu, estou aqui"
          ],
          "bars": [
            [
              0,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "Minha Mãe, vamos comigo",
            "Para sempre, eterna luz",
            "Para eu poder afirmar",
            "Para sempre a Santa Cruz"
          ],
          "bars": []
        },
        {
          "verses": [
            "Esta cruz do firmamento",
            "Que radéia a Santa luz",
            "Todos que nela firmar",
            "É para sempre amém Jesus"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "lyricsStatus": "transcribed_from_UNAQUI",
      "barsStatus": "double_checked_pdf_pending_author_visual_homologation",
