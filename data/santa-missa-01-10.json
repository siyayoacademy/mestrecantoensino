            "O sono da eternidade",
            "Deus do Céu quem te chamou"
          ],
          "bars": []
        },
        {
          "verses": [
            "Uma hora da madrugada",
            "Meu irmão se mudou",
            "O sono da eternidade",
            "Deus do Céu quem te chamou"
          ],
          "bars": []
        },
        {
          "verses": [
            "Duas Horas da madrugada...."
          ],
          "bars": []
        },
        {
          "verses": [
            "São três horas da madrugada..."
          ],
          "bars": []
        },
        {
          "verses": [
            "Quatro horas da madrugada..."
          ],
          "bars": []
        },
        {
          "verses": [
            "Cinco horas da manhã..."
          ],
          "bars": []
        },
        {
          "verses": [
            "São seis horas da manhã..."
          ],
          "bars": []
