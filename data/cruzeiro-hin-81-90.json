        {
          "verses": [
            "Sou campineiro e sou verdadeiro",
            "E é preciso eu viajar",
            "Que o poder de Deus é grande",
            "E eu desejo alcançar"
          ],
          "bars": []
        },
        {
          "verses": [
            "Me acho fraco e cansado",
            "De lutar com rebeldia",
            "Fazer gosto a quem não tem",
            "Na esperança de um dia"
