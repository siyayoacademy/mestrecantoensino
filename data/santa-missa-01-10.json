      "rhythm": "",
      "repeatLabel": null,
      "stanzas": [
        {
          "verses": [
            "Senhora Mãe Santíssima",
            "O Vosso Filho Ela mandou",
            "Está na frente da estrada",
            "Para quem lhe acompanhar"
          ],
          "bars": []
        },
        {
          "verses": [
            "Para quem lhe acompanhar",
            "Com fé e alegria",
            "Para a santíssima casa Dela",
            "Ela espera todo dia"
          ],
          "bars": []
        },
        {
          "verses": [
            "Ela espera todo dia",
            "O Divino Pai chamar",
            "Para a santíssima casa Dela",
            "Todos filhos lá chegar"
          ],
          "bars": []
        },
        {
          "verses": [
            "Todos filhos lá chegar",
            "E Ela a todos receber",
            "Para dar a Santa Glória",
            "Àqueles que merecer"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "language": "pt",
      "sourcePages": [
        11
      ],
      "source": "SANTA MISSA.pdf"
