      "rhythm": "",
      "repeatLabel": null,
      "stanzas": [
        {
          "verses": [
            "Oh meu Pai Eterno",
            "É Soberano Senhor",
            "É Rei no céu e na terra",
            "Um Pai Criador"
          ],
          "bars": []
        },
        {
          "verses": [
            "Oh Virgem Mãe",
            "É Soberana Senhora",
            "Rainha no céu e na terra",
            "Oh Mãe Criadora"
          ],
          "bars": []
        },
        {
          "verses": [
            "Oh meu Pai Eterno",
            "É Soberano Senhor",
            "Me perdoai os meus pecados",
            "Oh Pai Criador"
          ],
          "bars": []
        },
        {
          "verses": [
            "Oh Virgem Mãe",
            "É Soberana Senhora",
            "Me perdoai as minhas culpas",
            "Oh Mãe Poderosa"
          ],
          "bars": []
        },
        {
          "verses": [
            "Oh meu Pai Eterno do céu",
            "Jesus Cristo Salvador",
            "Nasceu de Virgem Maria",
            "Sofreu por Vosso amor"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "language": "pt",
