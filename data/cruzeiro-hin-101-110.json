      "title": "Sou filho desta verdade",
      "rhythm": "MARCHA",
      "offeredTo": null,
      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "Sou filho desta verdade",
            "E neste mundo estou aqui",
            "Dou conselho e dou conselho",
            "Para aqueles que me ouvir"
          ],
          "bars": [
            [
              0,
              2,
              9
            ],
            [
              2,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "O saber de todo mundo",
            "É um saber universal",
            "Aqui tem muita ciência",
            "Que é preciso se estudar"
          ],
          "bars": []
        },
        {
          "verses": [
            "Estudo fino, estudo fino",
            "Que é preciso conhecer",
            "Para ser bom professor",
            "Apresentar o seu saber"
          ],
          "bars": []
        }
      ],
      "visible": true,
      "lyricsStatus": "transcribed_from_UNAQUI",
      "barsStatus": "double_checked_pdf_pending_author_visual_homologation",
      "sourceUrl": "https://unaqui.wordpress.com/"
    },
    {
