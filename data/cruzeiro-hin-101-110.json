      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "Tudo, tudo Deus me mostra",
            "Para mim reconhecer",
            "Tudo, tudo é verdade",
            "E eu não posso me esquecer"
          ],
          "bars": [
            [
              0,
              2,
              9
            ],
            [
              2,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "A minha Mãe que me ensina",
            "Que me entrega este poder",
            "Tomo conta e dou conta",
            "E eu não posso me esquecer"
          ],
          "bars": []
        },
        {
          "verses": [
            "Sigo a minha viagem",
            "Dentro desta primozía",
            "Tudo, tudo é verdade",
            "No reino da soberania"
          ],
          "bars": []
        }
