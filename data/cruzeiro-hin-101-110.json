      "title": "Fortaleza",
      "rhythm": "MARCHA",
      "offeredTo": null,
      "performanceNote": null,
      "stanzas": [
        {
          "verses": [
            "Estando nesta fortaleza",
            "Onde me radéia o sol",
            "Encostado a meu Império",
            "Dono da força maior"
          ],
          "bars": [
            [
              0,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "Dono de todo poder",
            "Dono da força maior",
            "É Ele é quem me ensina",
            "Para eu ensinar os menores"
          ],
          "bars": []
        },
        {
          "verses": [
            "Para eu ensinar os menores",
            "Para todos aprender",
            "Para sempre louvar a Deus",
            "E saber agradecer"
          ],
          "bars": []
        }
      ],
      "visible": true,
