      "title": "Equiôr Papai Me Chama",
      "rhythm": "",
      "repeatLabel": null,
      "stanzas": [
        {
          "verses": [
            "Equior Papai me chama",
            "Equior perante a Si",
            "Equior Papai me diz",
            "Equior eu sou feliz"
          ],
          "bars": [
            [
              0,
              4,
              9
            ]
          ]
        },
        {
          "verses": [
            "Equior Mamãe me chama",
            "Equior Mamãe me dá",
            "Equior Mamãe me ensina",
            "Amar a quem eu devo amar"
          ],
          "bars": []
        },
        {
          "verses": [
            "Eu vivo neste mundo",
            "Com prazer e alegria",
            "Viva Deus no céu",
            "E a Sempre Virgem Maria"
          ],
          "bars": []
        },
        {
          "verses": [
            "Jesus Cristo é o nosso Pai",
            "De grande consolação",
            "Ajudai-me neste mundo",
            "E no outro a salvação"
          ],
          "bars": []
        }
      ],
      "visible": true,
